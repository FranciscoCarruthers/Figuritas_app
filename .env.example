NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Recommended for the full auth flow (registration, username lookup, password
# recovery) and required for push delivery. Server-side only; never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional Web Push configuration. Generate a pair with:
# npx web-push generate-vapid-keys
# Leave these empty to keep push disabled. Only the public key goes to the client.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# VAPID_SUBJECT example: mailto:you@example.com
